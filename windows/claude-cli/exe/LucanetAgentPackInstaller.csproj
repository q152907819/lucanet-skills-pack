<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LucanetAgentPackInstaller</AssemblyName>
    <RootNamespace>Lucanet.AgentPack.Installer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../install-claude-cli-windows.ps1" LogicalName="install-claude-cli-windows.ps1" />
    <EmbeddedResource Include="../doctor-claude-cli-windows.ps1" LogicalName="doctor-claude-cli-windows.ps1" />
    <EmbeddedResource Include="../manifest/claude-cli-windows.json" LogicalName="manifest/claude-cli-windows.json" />
    <EmbeddedResource Include="../payload/claude-win32-x64.exe" LogicalName="payload/claude-win32-x64.exe" Condition="Exists('../payload/claude-win32-x64.exe')" />
    <EmbeddedResource Include="../payload/claude-win32-x64.sha256" LogicalName="payload/claude-win32-x64.sha256" Condition="Exists('../payload/claude-win32-x64.sha256')" />
  </ItemGroup>
</Project>
